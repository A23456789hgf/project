<?php

namespace App\Providers;

use Illuminate\Support\ServiceProvider;
use App\Services\FrappeAPIService;
class FrappeServiceProvider extends ServiceProvider
{
    /**
     * Register services.
     */
    public function register()
    {
        $this->app->singleton(FrappeAPIService::class, function ($app) {
            return new FrappeAPIService();
        });

        $this->app->alias(FrappeAPIService::class, 'App\Services\FrappeService');
        $this->app->alias(FrappeAPIService::class, 'FrappeService');

        if (!class_exists('App\Services\FrappeService')) {
            class_alias(FrappeAPIService::class, 'App\Services\FrappeService');
        }
    }

    /**
     * Bootstrap services.
     */
    public function boot(): void
    {
        //
    }
}
