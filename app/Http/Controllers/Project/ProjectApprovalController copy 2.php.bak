<?php

namespace App\Http\Controllers\Project;

use App\Http\Controllers\Controller;
use App\Models\Authority;
use App\Models\Project;
use App\Models\ProjectApproval;
use App\Models\Stage;
use App\Models\StageStatus;
use App\Services\ApprovalService;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Log;
use Illuminate\Support\Facades\Storage;
use Illuminate\Support\Facades\Validator;
use Illuminate\Support\Str;

class ProjectApprovalController extends Controller
{
    protected ApprovalService $approvalService;

    public function __construct(ApprovalService $approvalService)
    {
        $this->approvalService = $approvalService;
    }

    /**
     * Handle project approval submission - UPDATED BASED ON REQUIREMENTS
     */
    public function approveProject(Request $request, Project $project): JsonResponse
    {
        $validator = Validator::make($request->all(), [
            'drop' => 'required|in:assembly,union,committee,implementation',
            'authority_id' => 'required|integer|exists:authorities,id',
            'status' => 'required|string|in:approved,rejected,need_action',
            'notes' => 'required_if:status,need_action,rejected|string|nullable',
            'attachment' => 'nullable|file|mimes:pdf,doc,docx,jpg,jpeg,png,ppt,pptx,xls,xlsx,txt,csv|max:20480',
        ]);

        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => $validator->errors()->first(),
                'errors' => $validator->errors(),
            ], 422);
        }

        try {
            DB::beginTransaction();

            $drop = $request->drop;
            $authorityId = $request->authority_id;
            $status = $request->status;
            $notes = $request->notes;

            // Validate status exists and is active (or create if doesn't exist)
            $statusConfig = [
                'approved' => [
                    'name_ar' => 'موافق',
                    'name_en' => 'Approved',
                    'category' => 'completed',
                    'color' => '#28a745',
                    'icon' => 'fa-check-circle',
                ],
                'rejected' => [
                    'name_ar' => 'مرفوض',
                    'name_en' => 'Rejected',
                    'category' => 'rejected',
                    'color' => '#dc3545',
                    'icon' => 'fa-times-circle',
                ],
                'need_action' => [
                    'name_ar' => 'بحاجة إلى إجراء',
                    'name_en' => 'Need Action',
                    'category' => 'revision',
                    'color' => '#ff6b6b',
                    'icon' => 'fa-exclamation-circle',
                ],
            ];

            if (! isset($statusConfig[$status])) {
                return response()->json([
                    'success' => false,
                    'message' => 'حالة المرحلة غير صالحة.',
                ], 422);
            }

            $stageStatus = StageStatus::firstOrCreate(
                ['code' => $status],
                array_merge($statusConfig[$status], [
                    'is_active' => true,
                    'is_system' => true,
                    'order' => ['approved' => 1, 'rejected' => 2, 'need_action' => 3][$status] ?? 0,
                ])
            );

            // Validate notes for rejection/need_action
            if (in_array($status, ['need_action', 'rejected']) && empty($notes)) {
                return response()->json([
                    'success' => false,
                    'message' => 'يجب إدخال ملاحظات أو أسباب عند رفض أو طلب إجراء.',
                ], 422);
            }

            // Get the current stage (or create if doesn't exist)
            $stageLabels = [
                'assembly' => 'موافقة الجمعية',
                'union' => 'موافقة الاتحاد',
                'committee' => 'موافقة اللجنة',
                'implementation' => 'مرحلة التنفيذ',
            ];

            $stageOrders = [
                'assembly' => 1,
                'union' => 2,
                'committee' => 3,
                'implementation' => 4,
            ];

            $stageTypes = [
                'assembly' => 'assessment',
                'union' => 'approval',
                'committee' => 'approval',
                'implementation' => 'implementation',
            ];

            $currentStage = Stage::firstOrCreate(
                ['code' => $drop],
                [
                    'name_ar' => $stageLabels[$drop] ?? $drop,
                    'order' => $stageOrders[$drop] ?? 0,
                    'type' => $stageTypes[$drop] ?? 'approval',
                    'is_active' => true,
                    'is_system' => true,
                ]
            );

            // Validate user has permission to approve this stage (check authority)
            $userAuthority = Authority::findOrFail($authorityId);

            // Get project's supervising authorities
            $projectAuthorities = $project->supervisingAuthorities()
                ->pluck('authority_id')
                ->toArray();

            // Check if user's authority is authorized for this project
            if (! in_array($authorityId, $projectAuthorities)) {
                return response()->json([
                    'success' => false,
                    'message' => 'ليس لديك صلاحية للموافقة على هذا المشروع. جهتك غير مصرحة لهذا المشروع.',
                ], 403);
            }

            // Validate stage is current/pending (not already approved or completed)
            $stageApproval = ProjectApproval::where('project_id', $project->id)
                ->where('drop', $drop)
                ->first();

            if ($stageApproval && in_array($stageApproval->status, ['approved', 'completed'])) {
                return response()->json([
                    'success' => false,
                    'message' => 'هذه المرحلة تمت الموافقة عليها مسبقًا ولا يمكن تغيير حالتها.',
                ], 422);
            }

            // Get current approval record
            $currentApproval = $stageApproval;

            if (! $currentApproval) {
                // Create if not exists
                $currentApproval = ProjectApproval::create([
                    'project_id' => $project->id,
                    'authority_id' => $authorityId,
                    'drop' => $drop,
                    'stage_id' => $currentStage->id,
                    'stage_status_id' => $stageStatus->id,
                    'step_order' => $currentStage->order,
                    'status' => $status,
                    'notes' => $notes,
                    'created_by' => auth()->id(),
                    'reviewed_at' => now(),
                ]);
            } else {
                // Update existing approval
                $currentApproval->update([
                    'stage_status_id' => $stageStatus->id,
                    'status' => $status,
                    'notes' => $notes,
                    'reviewed_at' => now(),
                    'created_by' => auth()->id(),
                ]);
            }

            // Store attachment if provided
            $attachmentPath = null;
            if ($request->hasFile('attachment')) {
                $attachmentPath = $this->storeAttachment($request->file('attachment'), $project);
                $currentApproval->update(['attachment' => $attachmentPath]);
            }

            // Handle status-specific logic
            $responseData = [];

            if ($status === 'approved') {
                // APPROVED: Move to next stage
                $result = $this->handleApprovedStatus($project, $currentApproval, $currentStage, $notes);
                $responseData = $result;

            } elseif ($status === 'need_action') {
                // NEED ACTION: Move to next stage but mark for action
                $result = $this->handleNeedActionStatus($project, $currentApproval, $currentStage, $notes);
                $responseData = $result;

            } elseif ($status === 'rejected') {
                // REJECTED: Move to next stage with rejection
                $result = $this->handleRejectedStatus($project, $currentApproval, $currentStage, $notes);
                $responseData = $result;
            }

            // Log the action
            $this->logProjectAction($project, $currentStage, $status, $notes);

            // Update overall project status
            $this->updateOverallProjectStatus($project);

            DB::commit();

            return response()->json([
                'success' => true,
                'message' => $responseData['message'] ?? 'تم معالجة المرحلة بنجاح',
                'approval' => $currentApproval->fresh(['authority', 'createdBy', 'stage', 'stageStatus']),
                'next_stage' => $responseData['next_stage'] ?? null,
                'next_stage_arabic' => $responseData['next_stage_arabic'] ?? null,
                'project_status' => $project->fresh()->status,
                'requires_return' => $status !== 'approved',
                'is_final_stage' => $responseData['is_final_stage'] ?? false,
            ], 200);

        } catch (\Exception $e) {
            DB::rollBack();

            Log::error('Project approval error', [
                'project_id' => $project->id,
                'user_id' => auth()->id(),
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء معالجة الموافقة: '.$e->getMessage(),
            ], 500);
        }
    }

    /**
     * Handle approved status - move to next stage
     */
    private function handleApprovedStatus(Project $project, ProjectApproval $currentApproval, Stage $currentStage, ?string $notes): array
    {
        // Check if this is the final stage
        $isFinalStage = ! $this->hasNextStage($currentStage);

        if ($isFinalStage) {
            // Final stage approved
            $project->update(['status' => 'completed']);

            return [
                'message' => 'تم الموافقة على المرحلة النهائية وإكمال المشروع.',
                'next_stage' => null,
                'next_stage_arabic' => null,
                'is_final_stage' => true,
            ];
        }

        // Get next stage
        $nextStage = $this->getNextStage($currentStage);

        if ($nextStage) {
            // Create approval record for next stage
            $this->createNextStageApproval($project, $nextStage, $currentApproval->authority_id);

            return [
                'message' => 'تم الموافقة على المرحلة والانتقال للمرحلة التالية.',
                'next_stage' => $nextStage->code,
                'next_stage_arabic' => $nextStage->name_ar,
                'is_final_stage' => false,
            ];
        }

        return [
            'message' => 'تم الموافقة على المرحلة.',
            'next_stage' => null,
            'next_stage_arabic' => null,
            'is_final_stage' => true,
        ];
    }

    /**
     * Handle need_action status - move to next stage but mark for return
     */
    private function handleNeedActionStatus(Project $project, ProjectApproval $currentApproval, Stage $currentStage, ?string $notes): array
    {
        // Get next stage if exists
        $nextStage = $this->getNextStage($currentStage);
        $hasNextStage = $nextStage !== null;

        if ($hasNextStage) {
            // Create approval record for next stage
            $nextApproval = $this->createNextStageApproval($project, $nextStage, $currentApproval->authority_id);

            // Mark next stage as requiring return to current stage
            $nextApproval->update([
                'requires_return_to' => $currentStage->id,
                'return_reason' => $notes,
                'status' => 'pending',
            ]);

            return [
                'message' => 'تم طلب إجراء على المرحلة والانتقال للمرحلة التالية. يجب العودة لهذه المرحلة لاحقاً.',
                'next_stage' => $nextStage->code,
                'next_stage_arabic' => $nextStage->name_ar,
                'requires_return' => true,
                'is_final_stage' => false,
            ];
        }

        // No next stage - mark project as needs action
        $project->update(['status' => 'needs_action']);

        return [
            'message' => 'تم طلب إجراء على المرحلة النهائية.',
            'next_stage' => null,
            'next_stage_arabic' => null,
            'requires_return' => true,
            'is_final_stage' => true,
        ];
    }

    /**
     * Handle rejected status - move to next stage with rejection
     */
    private function handleRejectedStatus(Project $project, ProjectApproval $currentApproval, Stage $currentStage, ?string $notes): array
    {
        // Get next stage if exists
        $nextStage = $this->getNextStage($currentStage);
        $hasNextStage = $nextStage !== null;

        if ($hasNextStage) {
            // Create approval record for next stage
            $nextApproval = $this->createNextStageApproval($project, $nextStage, $currentApproval->authority_id);

            // Mark next stage as requiring return due to rejection
            $nextApproval->update([
                'requires_return_to' => $currentStage->id,
                'return_reason' => $notes,
                'rejection_origin' => $currentStage->id,
                'status' => 'pending',
            ]);

            return [
                'message' => 'تم رفض المرحلة والانتقال للمرحلة التالية. يجب العودة لهذه المرحلة لاحقاً.',
                'next_stage' => $nextStage->code,
                'next_stage_arabic' => $nextStage->name_ar,
                'requires_return' => true,
                'is_final_stage' => false,
            ];
        }

        // No next stage - mark project as rejected
        $project->update(['status' => 'rejected']);

        return [
            'message' => 'تم رفض المرحلة النهائية والمشروع.',
            'next_stage' => null,
            'next_stage_arabic' => null,
            'requires_return' => false,
            'is_final_stage' => true,
        ];
    }

    /**
     * Return to previous stage for revision with optional resubmission
     */
    public function returnToStage(Request $request, Project $project): JsonResponse
    {
        $validator = Validator::make($request->all(), [
            'target_stage_id' => 'required|exists:stages,id',
            'reason' => 'required|string',
            'authority_id' => 'required|exists:authorities,id',
            'resubmit_now' => 'nullable|boolean',
        ]);

        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => $validator->errors()->first(),
            ], 422);
        }

        try {
            DB::beginTransaction();

            $targetStage = Stage::findOrFail($request->target_stage_id);
            $currentStage = $this->getCurrentStage($project);

            if (! $currentStage) {
                return response()->json([
                    'success' => false,
                    'message' => 'لا يوجد مرحلة حالية للمشروع.',
                ], 400);
            }

            // التحقق من إمكانية العودة للمرحلة المستهدفة
            if ($targetStage->order >= $currentStage->order) {
                return response()->json([
                    'success' => false,
                    'message' => 'لا يمكن العودة إلى مرحلة متقدمة أو نفس المرحلة الحالية.',
                ], 400);
            }

            // الحصول على حالات المرحلة
            $needsRevisionStatus = StageStatus::where('code', 'needs_revision')->first();
            $pendingStatus = StageStatus::where('code', 'pending')->first();

            if (! $needsRevisionStatus) {
                throw new \Exception('حالة "يحتاج تعديل" غير موجودة في النظام.');
            }

            // تحديث الموافقة الحالية
            $currentApproval = ProjectApproval::where('project_id', $project->id)
                ->where('stage_id', $currentStage->id)
                ->first();

            if ($currentApproval) {
                $currentApproval->update([
                    'returned_from_at' => now(),
                    'returned_by' => auth()->id(),
                ]);
            }

            // تحديد إذا كان سيتم إعادة تقديم فوري
            $shouldResubmit = $request->has('resubmit_now') && $request->resubmit_now === true;

            // تحضير بيانات الموافقة للمرحلة المستهدفة
            $approvalData = [
                'authority_id' => $request->authority_id,
                'drop' => $targetStage->code,
                'step_order' => $targetStage->order,
                'notes' => $request->reason."\n\n[تم الإرجاع من مرحلة: ".$currentStage->name_ar.']',
                'returned_to_at' => now(),
                'returned_by' => auth()->id(),
                'created_by' => auth()->id(),
                'requires_resubmission' => ! $shouldResubmit,
            ];

            // إعداد البيانات بناءً على نوع الإجراء
            if ($shouldResubmit) {
                // حالة إعادة التقديم الفوري
                $approvalData['stage_status_id'] = $pendingStatus ? $pendingStatus->id : null;
                $approvalData['status'] = 'pending';
                $approvalData['reviewed_at'] = null;
                $approvalData['resubmitted_at'] = now();
                $approvalData['resubmitted_by'] = auth()->id();
                $approvalData['notes'] .= "\n\n[تم إعادة التقديم الفوري عند الإرجاع]";
            } else {
                // حالة يحتاج تعديل
                $approvalData['stage_status_id'] = $needsRevisionStatus->id;
                $approvalData['status'] = 'needs_revision';
                $approvalData['reviewed_at'] = now();
                $approvalData['resubmitted_at'] = null;
                $approvalData['resubmitted_by'] = null;
            }

            // إنشاء أو تحديث الموافقة للمرحلة المستهدفة
            $targetApproval = ProjectApproval::updateOrCreate(
                [
                    'project_id' => $project->id,
                    'stage_id' => $targetStage->id,
                ],
                $approvalData
            );

            // حذف الموافقات للمراحل اللاحقة
            $this->deleteStagesAfter($project, $targetStage);

            // تحديث حالة المشروع
            $projectStatus = $shouldResubmit ? 'under_review' : 'under_revision';
            $project->update(['status' => $projectStatus]);

            // تسجيل الإجراء
            $actionType = $shouldResubmit ? 'resubmitted' : 'returned';
            $this->logProjectAction($project, $targetStage, $actionType, $request->reason);

            DB::commit();

            // تحضير رسالة الاستجابة
            $message = $shouldResubmit ?
                'تم إرجاع المشروع للمرحلة المطلوبة مع إعادة تقديم فوري.' :
                'تم إرجاع المشروع للمرحلة المطلوبة بنجاح. يرجى إعادة تقديم المشروع بعد التعديلات.';

            return response()->json([
                'success' => true,
                'message' => $message,
                'target_stage' => $targetStage->code,
                'target_stage_arabic' => $targetStage->name_ar,
                'project_status' => $project->status,
                'requires_resubmission' => ! $shouldResubmit,
                'resubmitted_immediately' => $shouldResubmit,
                'approval' => $targetApproval->fresh(['authority', 'stage', 'stageStatus']),
            ]);

        } catch (\Exception $e) {
            DB::rollBack();
            Log::error('Return to stage error', [
                'project_id' => $project->id,
                'target_stage_id' => $request->target_stage_id,
                'user_id' => auth()->id(),
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء إرجاع المشروع للمرحلة: '.$e->getMessage(),
            ], 500);
        }
    }

    /**
     * Get stages requiring return/attention
     */
    public function getStagesRequiringReturn(Project $project): JsonResponse
    {
        try {
            $stages = ProjectApproval::where('project_id', $project->id)
                ->where(function ($query) {
                    $query->where('status', 'need_action')
                        ->orWhere('status', 'rejected')
                        ->orWhereNotNull('requires_return_to');
                })
                ->with(['stage', 'authority'])
                ->orderBy('step_order')
                ->get()
                ->map(function ($approval) {
                    return [
                        'stage_id' => $approval->stage_id,
                        'stage_code' => $approval->drop,
                        'stage_name' => $approval->stage->name_ar ?? $approval->drop,
                        'status' => $approval->status,
                        'status_arabic' => $this->getStatusArabic($approval->status),
                        'notes' => $approval->notes,
                        'requires_return_to' => $approval->requires_return_to,
                        'return_reason' => $approval->return_reason,
                        'reviewed_at' => $approval->reviewed_at?->format('Y-m-d H:i'),
                        'authority' => $approval->authority->agency_name ?? 'غير معروف',
                    ];
                });

            return response()->json([
                'success' => true,
                'stages_requiring_return' => $stages,
                'total_count' => $stages->count(),
            ]);

        } catch (\Exception $e) {
            Log::error('Get stages requiring return error', [
                'project_id' => $project->id,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء جلب المراحل التي تحتاج إرجاع.',
            ], 500);
        }
    }

    /**
     * Resubmit project after addressing required actions
     */
    public function resubmit(Request $request, Project $project): JsonResponse
    {
        $validator = Validator::make($request->all(), [
            'stage_id' => 'required|exists:stages,id',
            'notes' => 'nullable|string',
            'attachment' => 'nullable|file|mimes:pdf,doc,docx,jpg,jpeg,png,ppt,pptx,xls,xlsx,txt,csv|max:20480',
        ]);

        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => $validator->errors()->first(),
            ], 422);
        }

        try {
            DB::beginTransaction();

            $stage = Stage::findOrFail($request->stage_id);

            // Find the approval that needs revision
            $approval = ProjectApproval::where('project_id', $project->id)
                ->where('stage_id', $stage->id)
                ->whereIn('status', ['needs_revision', 'need_action', 'rejected'])
                ->first();

            if (! $approval) {
                return response()->json([
                    'success' => false,
                    'message' => 'لا يوجد مرحلة تتطلب إعادة تقديم.',
                ], 400);
            }

            $pendingStatus = StageStatus::where('code', 'pending')->first();

            // Store attachment if provided
            $attachmentPath = $approval->attachment;
            if ($request->hasFile('attachment')) {
                $attachmentPath = $this->storeAttachment($request->file('attachment'), $project);
            }

            // Update approval status to pending
            $approval->update([
                'status' => 'pending',
                'stage_status_id' => $pendingStatus ? $pendingStatus->id : null,
                'notes' => $approval->notes."\n\n[تم إعادة التقديم بتاريخ ".now()->format('Y-m-d H:i')."]\n".($request->notes ?? ''),
                'attachment' => $attachmentPath,
                'reviewed_at' => null,
                'resubmitted_at' => now(),
                'resubmitted_by' => auth()->id(),
            ]);

            // Update project status
            if (in_array($project->status, ['under_revision', 'needs_action'])) {
                $project->update(['status' => 'in_progress']);
            }

            // Log the resubmission
            $this->logProjectAction($project, $stage, 'resubmitted', $request->notes ?? 'تم إعادة تقديم المشروع');

            DB::commit();

            return response()->json([
                'success' => true,
                'message' => 'تم إعادة تقديم المشروع بنجاح.',
                'approval' => $approval->fresh(['stage', 'stageStatus']),
            ]);

        } catch (\Exception $e) {
            DB::rollBack();
            Log::error('Project resubmit error', [
                'project_id' => $project->id,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء إعادة التقديم.',
            ], 500);
        }
    }

    /**
     * Get current approval status for a project
     */
    public function getApprovalStatus(Project $project): JsonResponse
    {
        try {
            $summary = $this->approvalService->getProjectApprovalSummary($project);
            $workflow = $this->approvalService->buildApprovalWorkflow($project);

            return response()->json([
                'success' => true,
                'summary' => $summary,
                'workflow' => $workflow,
                'current_status' => $this->getCurrentProjectStatus($project),
            ]);

        } catch (\Exception $e) {
            Log::error('Get approval status error', [
                'project_id' => $project->id,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء جلب حالة الموافقة.',
            ], 500);
        }
    }

    /**
     * Get approval attachments for a project
     */
    public function getApprovalAttachments(Project $project): JsonResponse
    {
        try {
            $attachments = ProjectApproval::where('project_id', $project->id)
                ->whereNotNull('attachment')
                ->with(['authority:id,agency_name', 'createdBy:id,name'])
                ->orderBy('created_at', 'desc')
                ->get()
                ->map(function ($approval) {
                    return [
                        'id' => $approval->id,
                        'drop' => $approval->drop,
                        'drop_arabic' => $this->getDropArabic($approval->drop),
                        'authority_name' => $approval->authority->agency_name ?? 'غير معروف',
                        'attachment_url' => Storage::url($approval->attachment),
                        'attachment_name' => basename($approval->attachment),
                        'file_size' => Storage::exists($approval->attachment) ?
                            $this->formatFileSize(Storage::size($approval->attachment)) : 'غير متوفر',
                        'created_at' => $approval->created_at->format('Y-m-d H:i:s'),
                        'status' => $approval->status,
                        'status_arabic' => $this->getStatusArabic($approval->status),
                        'reviewer_name' => $approval->createdBy->name ?? 'غير معروف',
                    ];
                });

            return response()->json([
                'success' => true,
                'attachments' => $attachments,
                'total_count' => $attachments->count(),
            ]);

        } catch (\Exception $e) {
            Log::error('Get approval attachments error', [
                'project_id' => $project->id,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء جلب المرفقات.',
            ], 500);
        }
    }

    /**
     * Download approval attachment
     */
    public function downloadAttachment($projectId, $approvalId): JsonResponse
    {
        try {
            $project = Project::findOrFail($projectId);
            $approval = ProjectApproval::where('project_id', $project->id)
                ->findOrFail($approvalId);

            if (! $approval->attachment || ! Storage::exists($approval->attachment)) {
                return response()->json([
                    'success' => false,
                    'message' => 'الملف غير موجود.',
                ], 404);
            }

            return response()->json([
                'success' => true,
                'download_url' => Storage::url($approval->attachment),
                'file_name' => basename($approval->attachment),
                'file_size' => $this->formatFileSize(Storage::size($approval->attachment)),
            ]);

        } catch (\Exception $e) {
            Log::error('Download attachment error', [
                'project_id' => $projectId,
                'approval_id' => $approvalId,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء تحميل الملف.',
            ], 500);
        }
    }

    /**
     * View attachment directly in browser
     */
    public function viewAttachment($projectId, $approvalId)
    {
        try {
            $project = Project::findOrFail($projectId);
            $approval = ProjectApproval::where('project_id', $project->id)
                ->findOrFail($approvalId);

            if (! $approval->attachment || ! Storage::exists($approval->attachment)) {
                abort(404, 'الملف غير موجود.');
            }

            $filePath = Storage::path($approval->attachment);
            $mimeType = Storage::mimeType($approval->attachment);

            return response()->file($filePath, [
                'Content-Type' => $mimeType,
                'Content-Disposition' => 'inline; filename="'.basename($approval->attachment).'"',
            ]);

        } catch (\Exception $e) {
            Log::error('View attachment error', [
                'project_id' => $projectId,
                'approval_id' => $approvalId,
                'error' => $e->getMessage(),
            ]);

            abort(404, 'الملف غير موجود.');
        }
    }

    /**
     * Get file content for text-based files
     */
    public function getFileContent($projectId, $approvalId): JsonResponse
    {
        try {
            $project = Project::findOrFail($projectId);
            $approval = ProjectApproval::where('project_id', $project->id)
                ->findOrFail($approvalId);

            if (! $approval->attachment || ! Storage::exists($approval->attachment)) {
                return response()->json([
                    'success' => false,
                    'message' => 'الملف غير موجود.',
                ], 404);
            }

            $fileExtension = pathinfo($approval->attachment, PATHINFO_EXTENSION);
            $allowedExtensions = ['txt', 'csv', 'log'];

            if (! in_array(strtolower($fileExtension), $allowedExtensions)) {
                return response()->json([
                    'success' => false,
                    'message' => 'هذا النوع من الملفات لا يمكن عرضه كنص.',
                ], 400);
            }

            $content = Storage::get($approval->attachment);

            return response()->json([
                'success' => true,
                'content' => $content,
                'file_name' => basename($approval->attachment),
                'file_size' => $this->formatFileSize(Storage::size($approval->attachment)),
                'encoding' => 'UTF-8',
            ]);

        } catch (\Exception $e) {
            Log::error('Get file content error', [
                'project_id' => $projectId,
                'approval_id' => $approvalId,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'خطأ في قراءة الملف: '.$e->getMessage(),
            ], 500);
        }
    }

    /**
     * Get detailed audit logs for project approvals
     */
    public function getApprovalAuditLog(Project $project): JsonResponse
    {
        try {
            $project = $project->load(['createdBy', 'supervisingAuthorities']);

            $approvals = ProjectApproval::withTrashed()->where('project_id', $project->id)
                ->with([
                    'authority:id,agency_name,parent_id',
                    'createdBy:id,name,email',
                    'stage',
                ])
                ->orderBy('step_order', 'asc')
                ->orderBy('created_at', 'desc')
                ->get()
                ->map(function ($approval) {
                    return [
                        'id' => $approval->id,
                        'drop' => $approval->drop,
                        'drop_arabic' => $this->getDropArabic($approval->drop),
                        'stage_name' => $approval->stage->name_ar ?? $approval->drop,
                        'authority_name' => $approval->authority->agency_name ?? 'غير معروف',
                        'authority_id' => $approval->authority_id,
                        'reviewer_name' => $approval->createdBy->name ?? 'غير معروف',
                        'reviewer_email' => $approval->createdBy->email ?? 'غير معروف',
                        'reviewer_id' => $approval->created_by,
                        'status' => $approval->status,
                        'status_arabic' => $this->getStatusArabic($approval->status),
                        'notes' => $approval->notes,
                        'attachment' => $approval->attachment ? [
                            'name' => basename($approval->attachment),
                            'url' => Storage::url($approval->attachment),
                            'size' => Storage::exists($approval->attachment) ?
                                $this->formatFileSize(Storage::size($approval->attachment)) : 'غير متوفر',
                            'type' => pathinfo($approval->attachment, PATHINFO_EXTENSION),
                        ] : null,
                        'created_at' => $approval->created_at->format('Y-m-d H:i:s'),
                        'updated_at' => $approval->updated_at->format('Y-m-d H:i:s'),
                        'reviewed_at' => $approval->reviewed_at?->format('Y-m-d H:i:s'),
                        'step_order' => $approval->step_order,
                        'duration' => $approval->reviewed_at ?
                            $this->calculateDuration($approval->created_at, $approval->reviewed_at) : null,
                        'requires_return_to' => $approval->requires_return_to,
                        'return_reason' => $approval->return_reason,
                        'is_returned' => $approval->returned_to_at !== null,
                    ];
                });

            $projectInfo = [
                'project_id' => $project->id,
                'project_name' => $project->name,
                'project_description' => $project->description,
                'project_status' => $project->status,
                'project_status_arabic' => $this->getProjectStatusArabic($project->status),
                'created_by' => $project->createdBy->name ?? 'غير معروف',
                'created_at' => $project->created_at->format('Y-m-d H:i:s'),
                'supervising_authorities' => $project->supervisingAuthorities->map(function ($authority) {
                    return [
                        'id' => $authority->id,
                        'name' => $authority->agency_name,
                        'type' => $authority->type,
                    ];
                })->toArray(),
                'total_budget' => $project->total_budget,
                'start_date' => $project->start_date?->format('Y-m-d'),
                'end_date' => $project->end_date?->format('Y-m-d'),
            ];

            $currentStatus = $this->getCurrentProjectStatus($project);

            return response()->json([
                'success' => true,
                'project_info' => $projectInfo,
                'audit_logs' => $approvals,
                'total_records' => $approvals->count(),
                'current_status' => $currentStatus,
                'timestamp' => now()->format('Y-m-d H:i:s'),
            ]);

        } catch (\Exception $e) {
            Log::error('Audit log error', [
                'project_id' => $project->id,
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء جلب سجلات الحركة: '.$e->getMessage(),
                'debug_info' => [
                    'project_id' => $project->id,
                    'timestamp' => now()->format('Y-m-d H:i:s'),
                ],
            ], 500);
        }
    }

    /**
     * Get project movement log
     */
    public function getProjectMovementLog(Project $project): JsonResponse
    {
        try {
            $approvals = ProjectApproval::withTrashed()
                ->where('project_id', $project->id)
                ->with(['authority', 'createdBy', 'stage'])
                ->orderBy('created_at', 'desc')
                ->get();

            $log = $approvals->map(function ($approval) {
                return [
                    'id' => $approval->id,
                    'timestamp' => ($approval->reviewed_at ?? $approval->updated_at ?? $approval->created_at)->format('Y-m-d H:i:s'),
                    'stage' => $approval->stage->name_ar ?? $this->getDropArabic($approval->drop),
                    'authority' => $approval->authority->agency_name ?? 'غير معروف',
                    'reviewer' => $approval->createdBy->name ?? 'غير معروف',
                    'status' => $approval->status,
                    'status_arabic' => $this->getStatusArabic($approval->status),
                    'notes' => $approval->notes,
                    'attachment' => $approval->attachment ? [
                        'name' => basename($approval->attachment),
                        'url' => Storage::url($approval->attachment),
                        'size' => Storage::exists($approval->attachment) ?
                            round(Storage::size($approval->attachment) / 1024 / 1024, 2).' MB' : 'غير متوفر',
                    ] : null,
                    'step_order' => $approval->step_order,
                    'is_return' => in_array($approval->status, ['need_action', 'needs_revision', 'rejected']),
                    'requires_return_to' => $approval->requires_return_to,
                ];
            });

            $approvals_history = [];
            $rejections_history = [];
            $required_actions_history = [];

            foreach ($log as $item) {
                if ($item['status'] === 'approved' || $item['status'] === 'pending') {
                    $approvals_history[] = $item;
                } elseif ($item['status'] === 'rejected') {
                    $rejections_history[] = $item;
                } elseif (in_array($item['status'], ['need_action', 'needs_revision', 'resubmit'])) {
                    $required_actions_history[] = $item;
                }
            }

            return response()->json([
                'success' => true,
                'project_id' => $project->id,
                'project_name' => $project->name,
                'movement_log' => $log,
                'approvals_history' => $approvals_history,
                'rejections_history' => $rejections_history,
                'required_actions_history' => $required_actions_history,
                'project_status' => $project->status,
                'total_movements' => count($log),
            ]);

        } catch (\Exception $e) {
            Log::error('Get project movement log error', [
                'project_id' => $project->id,
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء جلب سجل حركة المشروع: '.$e->getMessage(),
            ], 500);
        }
    }

