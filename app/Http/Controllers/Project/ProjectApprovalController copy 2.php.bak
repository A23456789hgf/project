                'project' => [
                    'id' => $project->id,
                    'name' => $project->name,
                    'status' => $project->status,
                ],
            ]);

        } catch (\Exception $e) {
            Log::error('Get approval statistics error', [
                'project_id' => $projectId,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء جلب إحصائيات الموافقات.',
            ], 500);
        }
    }

