    /**
     * Reset approval stage to pending (admin only)
     */
    public function resetApprovalStage($projectId, $approvalId): JsonResponse
    {
        if (! auth()->user() || ! auth()->user()->hasRole('admin')) {
            return response()->json([
                'success' => false,
                'message' => 'ليس لديك صلاحية لتنفيذ هذا الإجراء.',
            ], 403);
        }

        try {
            $project = Project::findOrFail($projectId);
            $approval = ProjectApproval::findOrFail($approvalId);

            if ($approval->project_id !== $project->id) {
                return response()->json([
                    'success' => false,
                    'message' => 'الموافقة غير مرتبطة بهذا المشروع.',
                ], 404);
            }

            $this->approvalService->resetApproval($approval);

            return response()->json([
                'success' => true,
                'message' => 'تم إعادة تعيين مرحلة الموافقة إلى قيد الانتظار.',
                'approval' => $approval->fresh(['authority', 'createdBy']),
            ]);

        } catch (\Exception $e) {
            Log::error('Reset approval stage error', [
                'project_id' => $projectId,
                'approval_id' => $approvalId,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء إعادة تعيين المرحلة.',
            ], 500);
        }
    }

    /**
     * Get pending approvals for current user's authority
     */
    public function getPendingApprovals(): JsonResponse
    {
        $user = auth()->user();

        if (! $user->authority_id) {
            return response()->json([
                'success' => false,
                'message' => 'المستخدم غير مرتبط بجهة.',
            ], 403);
        }

        try {
            $authority = Authority::find($user->authority_id);
            $pendingApprovals = $this->approvalService->getPendingApprovalsForAuthority($authority);

            return response()->json([
                'success' => true,
                'pending_approvals' => $pendingApprovals,
                'authority' => $authority->agency_name,
                'count' => $pendingApprovals->count(),
            ]);

        } catch (\Exception $e) {
            Log::error('Get pending approvals error', [
                'user_id' => $user->id,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء جلب الموافقات المعلقة.',
            ], 500);
        }
    }

    /**
     * Helper method: Get next stage
     */
    private function getNextStage(Stage $currentStage): ?Stage
    {
        return Stage::where('order', '>', $currentStage->order)
            ->where('is_active', true)
            ->orderBy('order')
            ->first();
    }

    /**
     * Helper method: Check if has next stage
     */
    private function hasNextStage(Stage $currentStage): bool
    {
        return Stage::where('order', '>', $currentStage->order)
            ->where('is_active', true)
            ->exists();
    }

    /**
     * Helper method: Create approval for next stage
     */
    private function createNextStageApproval(Project $project, Stage $nextStage, int $authorityId): ProjectApproval
    {
        $pendingStatus = StageStatus::where('code', 'pending')->first();

        return ProjectApproval::updateOrCreate(
            [
                'project_id' => $project->id,
                'stage_id' => $nextStage->id,
            ],
            [
                'authority_id' => $authorityId,
                'drop' => $nextStage->code,
                'stage_status_id' => $pendingStatus->id ?? null,
                'step_order' => $nextStage->order,
                'status' => 'pending',
                'created_by' => auth()->id(),
            ]
        );
    }

    /**
     * Store attachment file and return path
     */
    private function storeAttachment($file, Project $project): string
    {
        $originalName = $file->getClientOriginalName();
        $extension = $file->getClientOriginalExtension();
        $fileName = pathinfo($originalName, PATHINFO_FILENAME);
        $uniqueName = Str::slug($fileName).'_'.time().'.'.$extension;

        $path = $file->storeAs(
            "projects/{$project->id}/approvals",
            $uniqueName,
            'public'
        );

        return $path;
    }

    /**
     * Get drop name in Arabic
     */
    private function getDropArabic(string $drop): string
    {
        $stage = Stage::where('code', $drop)->first();

        return $stage ? $stage->name_ar : $drop;
    }

    /**
     * Get status in Arabic
     */
    private function getStatusArabic(string $status): string
    {
        $stageStatus = StageStatus::where('code', $status)->first();

        return $stageStatus ? $stageStatus->name_ar : $status;
    }

    /**
     * Get project status in Arabic
     */
    private function getProjectStatusArabic(string $status): string
    {
        $statuses = [
            'pending' => 'قيد الانتظار',
            'in_progress' => 'قيد التنفيذ',
            'execution' => 'مرحلة التنفيذ',
            'completed' => 'مكتمل',
            'rejected' => 'مرفوض',
            'need_action' => 'بحاجة إلى إجراء',
            'needs_action' => 'بحاجة إلى إجراء',
            'under_revision' => 'تحت المراجعة',
            'rolled_back_for_review' => 'تم إرجاعه للمراجعة',
            'on_hold' => 'معلق',
            'cancelled' => 'ملغي',
        ];

        return $statuses[$status] ?? $status;
    }

    /**
     * Get current project status based on approvals
     */
    private function getCurrentProjectStatus(Project $project): array
    {
        $totalStages = Stage::where('is_active', true)->count();
        $completedStages = ProjectApproval::where('project_id', $project->id)
            ->where('status', 'approved')
            ->count();

        $currentApproval = ProjectApproval::where('project_id', $project->id)
            ->where('status', 'pending')
            ->orderBy('step_order')
            ->first();

        $currentStage = $currentApproval ? $this->getDropArabic($currentApproval->drop) : null;

        if (! $currentStage) {
            if ($project->status === 'in_progress' || $project->status === 'completed') {
                $lastApproval = ProjectApproval::where('project_id', $project->id)
                    ->orderBy('step_order', 'desc')
                    ->first();
                $currentStage = $lastApproval ? $this->getDropArabic($lastApproval->drop) : null;
            }
        }

        $overallStatus = $project->status;

        // Build stage details
        $stageDetails = [];
        $approvals = ProjectApproval::where('project_id', $project->id)
            ->orderBy('step_order')
            ->get();

        foreach ($approvals as $approval) {
            $stageDetails[$approval->drop] = [
                'status' => $approval->status,
                'status_arabic' => $this->getStatusArabic($approval->status),
                'reviewed_at' => $approval->reviewed_at?->format('Y-m-d H:i:s'),
                'reviewer' => $approval->createdBy->name ?? 'غير معروف',
                'requires_return' => $approval->requires_return_to !== null,
            ];
        }

        $nextDrop = $currentApproval ? $this->getNextDrop($currentApproval->drop) : null;

        return [
            'overall_status' => $overallStatus,
            'overall_status_arabic' => $this->getProjectStatusArabic($overallStatus),
            'current_stage' => $currentStage,
            'completed_stages' => $completedStages,
            'total_stages' => $totalStages,
            'progress_percentage' => $totalStages > 0 ? round(($completedStages / $totalStages) * 100, 2) : 0,
            'stage_details' => $stageDetails,
            'next_stage' => $nextDrop,
            'next_stage_arabic' => $nextDrop ? $this->getDropArabic($nextDrop) : '',
            'requires_return' => $approvals->whereNotNull('requires_return_to')->count() > 0,
        ];
    }

    /**
     * Get next drop in sequence
     */
    private function getNextDrop(string $currentDrop): ?string
    {
        $currentStage = Stage::where('code', $currentDrop)->first();
        if (! $currentStage) {
            return null;
        }

        $nextStage = Stage::where('order', '>', $currentStage->order)
            ->orderBy('order', 'asc')
            ->first();

        return $nextStage ? $nextStage->code : null;
    }

    /**
     * Format file size to human readable format
     */
    private function formatFileSize($bytes): string
    {
        if ($bytes == 0) {
            return '0 B';
        }

        $units = ['B', 'KB', 'MB', 'GB'];
        $base = log($bytes, 1024);
        $floor = floor($base);

        return round(pow(1024, $base - $floor), 2).' '.$units[$floor];
    }

    /**
     * Calculate duration between two dates
     */
    private function calculateDuration($start, $end): string
    {
        $diff = $start->diff($end);

        if ($diff->days > 0) {
            return $diff->days.' يوم';
        } elseif ($diff->h > 0) {
            return $diff->h.' ساعة';
        } elseif ($diff->i > 0) {
            return $diff->i.' دقيقة';
        } else {
            return 'أقل من دقيقة';
        }
    }

    /**
     * Get overall status in Arabic
     */
    private function getOverallStatusArabic(string $status): string
    {
        $statuses = [
            'completed' => 'مكتمل',
            'execution' => 'مرحلة التنفيذ',
            'rejected' => 'مرفوض',
            'need_action' => 'بحاجة إلى إجراء',
            'needs_action' => 'بحاجة إلى إجراء',
            'rolled_back_for_review' => 'تم إرجاعه للمراجعة',
            'pending' => 'قيد الانتظار',
            'in_progress' => 'قيد التنفيذ',
            'under_revision' => 'تحت المراجعة',
        ];

        return $statuses[$status] ?? $status;
    }

    /**
     * Log project action to approval system
     */
    private function logProjectAction(Project $project, Stage $stage, string $action, ?string $notes = null): void
    {
        try {
            $this->approvalService->logProjectMovement(
                $project,
                $action,
                $stage->code,
                $notes ?? 'تم '.$this->getActionArabic($action),
                auth()->id()
            );
        } catch (\Exception $e) {
            Log::warning('Failed to log project action', [
                'project_id' => $project->id,
                'action' => $action,
                'error' => $e->getMessage(),
            ]);
        }
    }

    /**
     * Get action in Arabic
     */
    private function getActionArabic(string $action): string
    {
        $actions = [
            'approved' => 'الموافقة على المرحلة',
            'rejected' => 'رفض المرحلة',
            'need_action' => 'طلب إجراء على المرحلة',
            'resubmitted' => 'إعادة تقديم المشروع',
            'returned' => 'إرجاع المشروع',
        ];

        return $actions[$action] ?? $action;
    }

    /**
     * Update overall project status based on approval progress
     */
    private function updateOverallProjectStatus(Project $project): void
    {
        $approvals = $project->projectApprovals()
            ->orderBy('step_order')
            ->get();

        $lastApprovedStage = null;
        $hasRejected = false;
        $allApproved = true;

        foreach ($approvals as $approval) {
            if ($approval->status === 'approved') {
                $lastApprovedStage = $approval->drop;
            } elseif ($approval->status === 'rejected') {
                $hasRejected = true;
                $allApproved = false;
            } elseif ($approval->status !== 'approved') {
                $allApproved = false;
            }
        }

        if ($hasRejected) {
            $project->update(['status' => 'rejected']);
        } elseif ($allApproved && $lastApprovedStage === 'implementation') {
            $project->update(['status' => 'in_progress']);
        } elseif ($lastApprovedStage) {
            $project->update(['status' => 'pending_approval']);
        }
    }
}
