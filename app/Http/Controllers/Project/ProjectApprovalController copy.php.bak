<?php

namespace App\Http\Controllers\Project;

use App\Http\Controllers\Controller;
use App\Models\Authority;
use App\Models\Project;
use App\Models\ProjectApproval;
use App\Services\ApprovalService;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Log;
use Illuminate\Support\Facades\Storage;
use Illuminate\Support\Facades\Validator;
use Illuminate\Support\Str;

class ProjectApprovalController extends Controller
{
    protected ApprovalService $approvalService;

    public function __construct(ApprovalService $approvalService)
    {
        $this->approvalService = $approvalService;
    }

    /**
     * Handle project approval submission
     */
    public function approveProject(Request $request, Project $project): JsonResponse
    {

        $validator = Validator::make($request->all(), [
            'drop' => 'required|in:assembly,union,committee',
            'authority_id' => 'required|integer|exists:authorities,id',
            'status' => 'required|in:approved,financial_review,need_action,rejected',
            'notes' => 'required_if:status,need_action,rejected|string|nullable',
            'attachment' => 'nullable|file|mimes:pdf,doc,docx,jpg,jpeg,png,ppt,pptx,xls,xlsx,txt,csv|max:20480',
            'financial_adjustments' => 'nullable|json',
        ]);

        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => $validator->errors()->first(),
                'errors' => $validator->errors(),
            ], 422);
        }

        try {
            DB::beginTransaction();

            $drop = $request->drop;
            $authorityId = $request->authority_id;
            $status = $request->status;
            $notes = $request->notes;

            if (in_array($status, ['need_action', 'rejected']) && empty($notes)) {
                return response()->json([
                    'success' => false,
                    'message' => 'يجب إدخال ملاحظات أو أسباب عند رفض أو طلب إجراء.',
                ], 422);
            }

            if (! $this->isAuthorityValidForProject($project, $authorityId)) {
                return response()->json([
                    'success' => false,
                    'message' => 'هذه الجهة غير مصرح لها بمراجعة هذا المشروع.',
                ], 403);
            }

            // التحقق من التسلسل فقط في حالة الموافقة
            if ($status === 'approved' && ! $this->canApproveDropSequentially($project, $drop)) {
                return response()->json([
                    'success' => false,
                    'message' => 'يجب إكمال المراحل السابقة أولاً قبل المتابعة للمرحلة التالية.',
                ], 400);
            }

            $projectApproval = ProjectApproval::where('project_id', $project->id)
                ->where('drop', $drop)
                ->first();

            if (! $projectApproval) {
                $dropOrder = $this->getDropOrder($drop);
                $projectApproval = ProjectApproval::create([
                    'project_id' => $project->id,
                    'authority_id' => $authorityId,
                    'drop' => $drop,
                    'step_order' => $dropOrder,
                    'status' => 'pending',
                    'created_by' => auth()->id(),
                ]);
            }

            if (! $projectApproval->isPending() && in_array($status, ['approved', 'financial_review'])) {
                return response()->json([
                    'success' => false,
                    'message' => 'لا يمكن الموافقة على مرحلة تم البت فيها بالفعل.',
                ], 400);
            }

            $attachmentPath = null;
            if ($request->hasFile('attachment')) {
                $attachmentPath = $this->storeAttachment($request->file('attachment'), $project);
            }

            if ($status === 'approved') {
                $this->approvalService->approveStage(
                    $projectApproval,
                    $notes ?? '',
                    $attachmentPath,
                    auth()->id()
                );

                if ($request->has('financial_adjustments')) {
                    $this->applyFinancialAdjustments($request->input('financial_adjustments'), $project);
                }

                $this->createNextDropStage($project, $drop);

                // تحديث حالة المشروع إذا اكتملت جميع المراحل
                $this->updateProjectStatus($project);

                DB::commit();

                return response()->json([
                    'success' => true,
                    'message' => 'تم الموافقة على المشروع بنجاح.',
                    'approval' => $projectApproval->fresh(['authority', 'createdBy']),
                ], 200);

            } elseif ($status === 'financial_review') {
                // معالجة حالة المراجعة المالية - تطبيق التعديلات المالية فقط
                $reviewNotes = 'تمت مراجعة مالية للمشروع';
                if ($notes) {
                    $reviewNotes .= ': '.$notes;
                }

                // تطبيق التعديلات المالية
                if ($request->has('financial_adjustments')) {
                    $this->applyFinancialAdjustments($request->input('financial_adjustments'), $project);
                }

                // تحديث ملاحظات المرحلة مع الاحتفاظ بالحالة pending
                $projectApproval->update([
                    'notes' => ($projectApproval->notes ? $projectApproval->notes."\n\n" : '').$reviewNotes,
                    'updated_at' => now(),
                ]);

                if ($attachmentPath) {
                    $projectApproval->update(['attachment' => $attachmentPath]);
                }

                DB::commit();

                return response()->json([
                    'success' => true,
                    'message' => 'تم تطبيق التعديلات المالية بنجاح.',
                    'approval' => $projectApproval->fresh(['authority', 'createdBy']),
                ], 200);

            } elseif ($status === 'need_action') {
                // معالجة حالة "بحاجة إلى إجراء" - إرجاع إلى المرحلة السابقة
                $this->handleNeedAction($project, $projectApproval, $drop, $notes, $attachmentPath);

                DB::commit();

                return response()->json([
                    'success' => true,
                    'message' => 'تم طلب إجراء على المشروع وإرجاعه إلى المرحلة السابقة.',
                    'approval' => $projectApproval->fresh(['authority', 'createdBy']),
                    'returned_to_previous' => true,
                ], 200);

            } elseif ($status === 'rejected') {
                $this->approvalService->rejectStage(
                    $projectApproval,
                    $notes,
                    $attachmentPath,
                    auth()->id()
                );

                // تحديث حالة المشروع إلى مرفوض
                $project->update(['status' => 'rejected']);

                DB::commit();

                return response()->json([
                    'success' => true,
                    'message' => 'تم رفض المشروع.',
                    'approval' => $projectApproval->fresh(['authority', 'createdBy']),
                ], 200);
            }

        } catch (\Exception $e) {
            DB::rollBack();

            Log::error('Project approval error', [
                'project_id' => $project->id,
                'user_id' => auth()->id(),
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء معالجة الموافقة: '.$e->getMessage(),
            ], 500);
        }
    }

    /**
     * Handle need_action status - return project to previous stage
     */
    private function handleNeedAction(Project $project, ProjectApproval $currentApproval, string $currentDrop, string $notes, ?string $attachmentPath): void
    {
        // تحديث المرحلة الحالية بحالة need_action
        $this->approvalService->requestRevision(
            $currentApproval,
            $notes,
            auth()->id()
        );

        if ($attachmentPath) {
            $currentApproval->update(['attachment' => $attachmentPath]);
        }

        // إرجاع المشروع إلى المرحلة السابقة
        $previousDrop = $this->getPreviousDrop($currentDrop);

        if ($previousDrop) {
            $previousApproval = ProjectApproval::where('project_id', $project->id)
                ->where('drop', $previousDrop)
                ->first();

            if ($previousApproval) {
                // إعادة فتح المرحلة السابقة
                $previousApproval->update([
                    'status' => 'pending',
                    'notes' => $previousApproval->notes."\n\n[تم الإرجاع من مرحلة ".$this->getDropArabic($currentDrop).' بسبب طلب إجراء: '.$notes.']',
                    'updated_at' => now(),
                    'reviewed_at' => null,
                ]);

                // حذف أي مراحل لاحقة (بعد المرحلة الحالية)
                $this->deleteSubsequentStages($project, $currentDrop);
            }
        }

        // تحديث حالة المشروع
        $project->update(['status' => 'need_action']);
    }

    /**
     * Update project status based on approvals
     */
    private function updateProjectStatus(Project $project): void
    {
        $assemblyApproved = ProjectApproval::where('project_id', $project->id)
            ->where('drop', 'assembly')
            ->where('status', 'approved')
            ->exists();

        $unionApproved = ProjectApproval::where('project_id', $project->id)
            ->where('drop', 'union')
            ->where('status', 'approved')
            ->exists();

        $committeeApproved = ProjectApproval::where('project_id', $project->id)
            ->where('drop', 'committee')
            ->where('status', 'approved')
            ->exists();

        if ($committeeApproved) {
            $project->update(['status' => 'completed']);
        } elseif ($unionApproved) {
            $project->update(['status' => 'committee_approval']);
        } elseif ($assemblyApproved) {
            $project->update(['status' => 'union_approval']);
        } else {
            $project->update(['status' => 'assembly_approval']);
        }
    }

    /**
     * Get previous drop in sequence
     */
    private function getPreviousDrop(string $currentDrop): ?string
    {
        $drops = ['assembly', 'union', 'committee'];
        $currentIndex = array_search($currentDrop, $drops);

        return ($currentIndex > 0) ? $drops[$currentIndex - 1] : null;
    }

    /**
     * Delete subsequent approval stages
     */
    private function deleteSubsequentStages(Project $project, string $currentDrop): void
    {
        $drops = ['assembly', 'union', 'committee'];
        $currentIndex = array_search($currentDrop, $drops);

        if ($currentIndex < count($drops) - 1) {
            for ($i = $currentIndex + 1; $i < count($drops); $i++) {
                $laterDrop = $drops[$i];
                ProjectApproval::where('project_id', $project->id)
                    ->where('drop', $laterDrop)
                    ->delete();
            }
        }
    }

    /**
     * Verify that the authority is one of the supervising authorities for this project
     */
    private function isAuthorityValidForProject(Project $project, int $authorityId): bool
    {
        $supervisingAuthorities = $project->supervisingAuthorities()
            ->pluck('authority_id')
            ->toArray();

        // Allow approval if no supervising authorities are set for the project
        if (empty($supervisingAuthorities)) {
            return true;
        }

        if (in_array($authorityId, $supervisingAuthorities)) {
            return true;
        }

        $authority = Authority::find($authorityId);
        if (! $authority) {
            return false;
        }

        $current = $authority;
        while ($current) {
            if (in_array($current->id, $supervisingAuthorities)) {
                return true;
            }
            $current = $current->parent;
        }

        return false;
    }

    /**
     * Check if a drop can be approved sequentially
     */
    private function canApproveDropSequentially(Project $project, string $drop): bool
    {
        $drops = ['assembly', 'union', 'committee'];
        $currentIndex = array_search($drop, $drops);

        for ($i = 0; $i < $currentIndex; $i++) {
            $previousDrop = $drops[$i];
            $previousApproval = ProjectApproval::where('project_id', $project->id)
                ->where('drop', $previousDrop)
                ->first();

            if (! $previousApproval || $previousApproval->status !== 'approved') {
                return false;
            }
        }

        return true;
    }

    /**
     * Store attachment file and return path
     */
    private function storeAttachment($file, Project $project): string
    {
        $originalName = $file->getClientOriginalName();
        $extension = $file->getClientOriginalExtension();
        $fileName = pathinfo($originalName, PATHINFO_FILENAME);
        $uniqueName = Str::slug($fileName).'_'.time().'.'.$extension;

        $path = $file->storeAs(
            "projects/{$project->id}/approvals",
            $uniqueName,
            'public'
        );

        return $path;
    }

    /**
     * Create next drop stage if it exists
     */
    private function createNextDropStage(Project $project, string $drop)
    {
        $drops = ['assembly', 'union', 'committee'];
        $currentIndex = array_search($drop, $drops);

        if ($currentIndex < count($drops) - 1) {
            $nextDrop = $drops[$currentIndex + 1];

            $existingApproval = ProjectApproval::where('project_id', $project->id)
                ->where('drop', $nextDrop)
                ->first();

            if (! $existingApproval) {
                $nextDropOrder = $this->getDropOrder($nextDrop);

                // Try to get authority from supervising authorities
                $supervisingAuthority = $project->supervisingAuthorities()->first();
                $authorityId = $supervisingAuthority ? $supervisingAuthority->authority_id : null;

                // If no supervising authority, use the authority that just approved the current drop
                if (! $authorityId) {
                    $currentApproval = ProjectApproval::where('project_id', $project->id)
                        ->where('drop', $drop)
                        ->first();
                    $authorityId = $currentApproval ? $currentApproval->authority_id : 1;
                }

                // Final fallback to first authority in system
                if (! $authorityId) {
                    $authority = Authority::first();
                    $authorityId = $authority ? $authority->id : 1;
                }

                ProjectApproval::create([
                    'project_id' => $project->id,
                    'authority_id' => $authorityId,
                    'drop' => $nextDrop,
                    'step_order' => $nextDropOrder,
                    'status' => 'pending',
                    'created_by' => auth()->id(),
                ]);
            }
        }
    }

    /**
     * Get drop order for step_order field
     */
    private function getDropOrder(string $drop): int
    {
        $drops = ['assembly', 'union', 'committee'];
        $index = array_search($drop, $drops);

        return $index !== false ? $index + 1 : 1;
    }

    /**
     * Get current approval status for a project
     */
    public function getApprovalStatus(Project $project): JsonResponse
    {
        try {

            $summary = $this->approvalService->getProjectApprovalSummary($project);
            $workflow = $this->approvalService->buildApprovalWorkflow($project);

            return response()->json([
                'success' => true,
                'summary' => $summary,
                'workflow' => $workflow,
                'current_status' => $this->getCurrentProjectStatus($project),
            ]);

        } catch (\Exception $e) {
            Log::error('Get approval status error', [
                'project_id' => $project->id,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء جلب حالة الموافقة.',
            ], 500);
        }
    }

    /**
     * Get approval attachments for a project
     */
    public function getApprovalAttachments(Project $project): JsonResponse
    {
        try {

            $attachments = ProjectApproval::where('project_id', $project->id)
                ->whereNotNull('attachment')
                ->with(['authority:id,agency_name', 'createdBy:id,name'])
                ->orderBy('created_at', 'desc')
                ->get()
                ->map(function ($approval) {
                    return [
                        'id' => $approval->id,
                        'drop' => $approval->drop,
                        'drop_arabic' => $this->getDropArabic($approval->drop),
                        'authority_name' => $approval->authority->agency_name ?? 'غير معروف',
                        'attachment_url' => Storage::url($approval->attachment),
                        'attachment_name' => basename($approval->attachment),
                        'file_size' => Storage::exists($approval->attachment) ?
                            $this->formatFileSize(Storage::size($approval->attachment)) : 'غير متوفر',
                        'created_at' => $approval->created_at->format('Y-m-d H:i:s'),
                        'status' => $approval->status,
                        'status_arabic' => $this->getStatusArabic($approval->status),
                        'reviewer_name' => $approval->createdBy->name ?? 'غير معروف',
                    ];
                });

            return response()->json([
                'success' => true,
                'attachments' => $attachments,
                'total_count' => $attachments->count(),
            ]);

        } catch (\Exception $e) {
            Log::error('Get approval attachments error', [
                'project_id' => $project->id,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء جلب المرفقات.',
            ], 500);
        }
    }

    /**
     * Format file size to human readable format
     */
    private function formatFileSize($bytes): string
    {
        if ($bytes == 0) {
            return '0 B';
        }

        $units = ['B', 'KB', 'MB', 'GB'];
        $base = log($bytes, 1024);
        $floor = floor($base);

        return round(pow(1024, $base - $floor), 2).' '.$units[$floor];
    }

    /**
     * Download approval attachment
     */
    public function downloadAttachment($projectId, $approvalId): JsonResponse
    {
        try {
            $project = Project::findOrFail($projectId);
            $approval = ProjectApproval::where('project_id', $project->id)
                ->findOrFail($approvalId);

            if (! $approval->attachment || ! Storage::exists($approval->attachment)) {
                return response()->json([
                    'success' => false,
                    'message' => 'الملف غير موجود.',
                ], 404);
            }

            return response()->json([
                'success' => true,
                'download_url' => Storage::url($approval->attachment),
                'file_name' => basename($approval->attachment),
                'file_size' => $this->formatFileSize(Storage::size($approval->attachment)),
            ]);

        } catch (\Exception $e) {
            Log::error('Download attachment error', [
                'project_id' => $projectId,
                'approval_id' => $approvalId,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء تحميل الملف.',
            ], 500);
        }
    }

    /**
     * View attachment directly in browser
     */
    public function viewAttachment($projectId, $approvalId)
    {
        try {
            $project = Project::findOrFail($projectId);
            $approval = ProjectApproval::where('project_id', $project->id)
                ->findOrFail($approvalId);

            if (! $approval->attachment || ! Storage::exists($approval->attachment)) {
                abort(404, 'الملف غير موجود.');
            }

            $filePath = Storage::path($approval->attachment);
            $mimeType = Storage::mimeType($approval->attachment);

            return response()->file($filePath, [
                'Content-Type' => $mimeType,
                'Content-Disposition' => 'inline; filename="'.basename($approval->attachment).'"',
            ]);

        } catch (\Exception $e) {
            Log::error('View attachment error', [
                'project_id' => $projectId,
                'approval_id' => $approvalId,
                'error' => $e->getMessage(),
            ]);

            abort(404, 'الملف غير موجود.');
        }
    }

    /**
     * Get file content for text-based files
     */
    public function getFileContent($projectId, $approvalId): JsonResponse
    {
        try {
            $project = Project::findOrFail($projectId);
            $approval = ProjectApproval::where('project_id', $project->id)
                ->findOrFail($approvalId);

            if (! $approval->attachment || ! Storage::exists($approval->attachment)) {
                return response()->json([
                    'success' => false,
                    'message' => 'الملف غير موجود.',
                ], 404);
            }

            $fileExtension = pathinfo($approval->attachment, PATHINFO_EXTENSION);
            $allowedExtensions = ['txt', 'csv', 'log'];

            if (! in_array(strtolower($fileExtension), $allowedExtensions)) {
                return response()->json([
                    'success' => false,
                    'message' => 'هذا النوع من الملفات لا يمكن عرضه كنص.',
                ], 400);
            }

            $content = Storage::get($approval->attachment);

            return response()->json([
                'success' => true,
                'content' => $content,
                'file_name' => basename($approval->attachment),
                'file_size' => $this->formatFileSize(Storage::size($approval->attachment)),
                'encoding' => 'UTF-8',
            ]);

        } catch (\Exception $e) {
            Log::error('Get file content error', [
                'project_id' => $projectId,
                'approval_id' => $approvalId,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'خطأ في قراءة الملف: '.$e->getMessage(),
            ], 500);
        }
    }

    /**
     * Get detailed audit logs for project approvals - IMPROVED VERSION
     */
    public function getApprovalAuditLog(Project $project): JsonResponse
    {
        try {
            $project = $project->load(['createdBy', 'supervisingAuthorities']);

            $approvals = ProjectApproval::where('project_id', $project->id)
                ->with([
                    'authority:id,agency_name,parent_id',
                    'createdBy:id,name,email',
                ])
                ->orderBy('created_at', 'asc')
                ->get();

            $activityLog = [];
            $dropPendingCount = [];

            foreach ($approvals as $approval) {
                $dropKey = $approval->drop;

                if (! isset($dropPendingCount[$dropKey])) {
                    $dropPendingCount[$dropKey] = 0;
                }

                if ($approval->status === 'pending') {
                    $dropPendingCount[$dropKey]++;
                    $eventType = ($dropPendingCount[$dropKey] === 1) ? 'submission' : 'resubmission';
                    $eventText = ($eventType === 'submission')
                        ? 'تم تقديم المشروع من '.$approval->authority->agency_name
                        : 'تم إعادة تقديم المشروع بعد تطبيق التعديلات المطلوبة';

                    $activityLog[] = [
                        'type' => $eventType,
                        'event' => $eventText,
                        'stage' => $this->getDropArabic($approval->drop),
                        'drop' => $approval->drop,
                        'status' => 'pending',
                        'authority_name' => $approval->authority->agency_name ?? 'غير معروف',
                        'reviewer_name' => $approval->createdBy->name ?? 'غير معروف',
                        'timestamp' => $approval->created_at->format('Y-m-d H:i:s'),
                        'created_at' => $approval->created_at->format('Y-m-d H:i:s'),
                        'notes' => null,
                        'attachment' => null,
                    ];
                } elseif ($approval->status === 'approved') {
                    $activityLog[] = [
                        'type' => 'approval',
                        'event' => 'تمت الموافقة على المشروع من قبل '.$approval->authority->agency_name,
                        'stage' => $this->getDropArabic($approval->drop),
                        'drop' => $approval->drop,
                        'status' => 'approved',
                        'authority_name' => $approval->authority->agency_name ?? 'غير معروف',
                        'reviewer_name' => $approval->createdBy->name ?? 'غير معروف',
                        'timestamp' => $approval->reviewed_at?->format('Y-m-d H:i:s') ?? $approval->updated_at->format('Y-m-d H:i:s'),
                        'created_at' => $approval->created_at->format('Y-m-d H:i:s'),
                        'notes' => $approval->notes,
                        'attachment' => $approval->attachment ? [
                            'name' => basename($approval->attachment),
                            'url' => Storage::url($approval->attachment),
                            'size' => Storage::exists($approval->attachment) ?
                                $this->formatFileSize(Storage::size($approval->attachment)) : 'غير متوفر',
                            'type' => pathinfo($approval->attachment, PATHINFO_EXTENSION),
                        ] : null,
                    ];
                } elseif ($approval->status === 'need_action') {
                    $activityLog[] = [
                        'type' => 'return',
                        'event' => 'تم إرجاع المشروع من قبل '.$approval->authority->agency_name.' لإجراء تعديلات',
                        'stage' => $this->getDropArabic($approval->drop),
                        'drop' => $approval->drop,
                        'status' => 'need_action',
                        'authority_name' => $approval->authority->agency_name ?? 'غير معروف',
                        'reviewer_name' => $approval->createdBy->name ?? 'غير معروف',
                        'timestamp' => $approval->reviewed_at?->format('Y-m-d H:i:s') ?? $approval->updated_at->format('Y-m-d H:i:s'),
                        'created_at' => $approval->created_at->format('Y-m-d H:i:s'),
                        'notes' => $approval->notes,
                        'attachment' => $approval->attachment ? [
                            'name' => basename($approval->attachment),
                            'url' => Storage::url($approval->attachment),
                            'size' => Storage::exists($approval->attachment) ?
                                $this->formatFileSize(Storage::size($approval->attachment)) : 'غير متوفر',
                            'type' => pathinfo($approval->attachment, PATHINFO_EXTENSION),
                        ] : null,
                    ];
                } elseif ($approval->status === 'rejected') {
                    $activityLog[] = [
                        'type' => 'rejection',
                        'event' => 'تم رفض المشروع من قبل '.$approval->authority->agency_name,
                        'stage' => $this->getDropArabic($approval->drop),
                        'drop' => $approval->drop,
                        'status' => 'rejected',
                        'authority_name' => $approval->authority->agency_name ?? 'غير معروف',
                        'reviewer_name' => $approval->createdBy->name ?? 'غير معروف',
                        'timestamp' => $approval->reviewed_at?->format('Y-m-d H:i:s') ?? $approval->updated_at->format('Y-m-d H:i:s'),
                        'created_at' => $approval->created_at->format('Y-m-d H:i:s'),
                        'notes' => $approval->notes,
                        'attachment' => $approval->attachment ? [
                            'name' => basename($approval->attachment),
                            'url' => Storage::url($approval->attachment),
                            'size' => Storage::exists($approval->attachment) ?
                                $this->formatFileSize(Storage::size($approval->attachment)) : 'غير متوفر',
                            'type' => pathinfo($approval->attachment, PATHINFO_EXTENSION),
                        ] : null,
                    ];
                }
            }

            usort($activityLog, function ($a, $b) {
                return strtotime($a['timestamp']) - strtotime($b['timestamp']);
            });

            $projectInfo = [
                'project_id' => $project->id,
                'project_name' => $project->name,
                'project_description' => $project->description,
                'project_status' => $project->status,
                'project_status_arabic' => $this->getProjectStatusArabic($project->status),
                'created_by' => $project->createdBy->name ?? 'غير معروف',
                'created_at' => $project->created_at->format('Y-m-d H:i:s'),
                'supervising_authorities' => $project->supervisingAuthorities->map(function ($authority) {
                    return [
                        'id' => $authority->id,
                        'name' => $authority->agency_name,
                        'type' => $authority->type,
                    ];
                })->toArray(),
                'total_budget' => $project->total_budget,
                'start_date' => $project->start_date?->format('Y-m-d'),
                'end_date' => $project->end_date?->format('Y-m-d'),
            ];

            $currentStatus = $this->getCurrentProjectStatus($project);

            return response()->json([
                'success' => true,
                'project_info' => $projectInfo,
                'audit_logs' => $activityLog,
                'total_records' => count($activityLog),
                'current_status' => $currentStatus,
                'timestamp' => now()->format('Y-m-d H:i:s'),
            ]);

        } catch (\Exception $e) {
            Log::error('Audit log error', [
                'project_id' => $project->id,
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء جلب سجلات الحركة: '.$e->getMessage(),
                'debug_info' => [
                    'project_id' => $project->id,
                    'timestamp' => now()->format('Y-m-d H:i:s'),
                ],
            ], 500);
        }
    }

    /**
     * Calculate duration between two dates
     */
    private function calculateDuration($start, $end): string
    {
        $diff = $start->diff($end);

        if ($diff->days > 0) {
            return $diff->days.' يوم';
        } elseif ($diff->h > 0) {
            return $diff->h.' ساعة';
        } elseif ($diff->i > 0) {
            return $diff->i.' دقيقة';
        } else {
            return 'أقل من دقيقة';
        }
    }

    /**
     * Get project status in Arabic
     */
    private function getProjectStatusArabic(string $status): string
    {
        $statuses = [
            'pending' => 'قيد الانتظار',
            'in_progress' => 'قيد التنفيذ',
            'completed' => 'مكتمل',
            'rejected' => 'مرفوض',
            'need_action' => 'بحاجة إلى إجراء',
            'on_hold' => 'معلق',
            'cancelled' => 'ملغي',
        ];

        return $statuses[$status] ?? $status;
    }

    /**
     * Get current project status based on approvals
     */
    private function getCurrentProjectStatus(Project $project): array
    {
        $approvals = ProjectApproval::where('project_id', $project->id)
            ->orderBy('step_order')
            ->get();

        $currentStage = null;
        $overallStatus = 'pending';
        $completedStages = 0;
        $totalStages = 3; // assembly, union, committee
        $stageDetails = [];

        foreach ($approvals as $approval) {
            $stageDetails[$approval->drop] = [
                'status' => $approval->status,
                'status_arabic' => $this->getStatusArabic($approval->status),
                'reviewed_at' => $approval->reviewed_at?->format('Y-m-d H:i:s'),
                'reviewer' => $approval->createdBy->name ?? 'غير معروف',
            ];

            if ($approval->status === 'approved') {
                $completedStages++;
                $currentStage = $approval->drop;
            } elseif ($approval->status === 'rejected') {
                $overallStatus = 'rejected';
                break;
            } elseif ($approval->status === 'need_action') {
                $overallStatus = 'need_action';
                break;
            } elseif ($approval->status === 'pending') {
                $overallStatus = 'pending';
                $currentStage = $approval->drop;
                break;
            }
        }

        if ($completedStages === $totalStages) {
            $overallStatus = 'completed';
        }

        return [
            'overall_status' => $overallStatus,
            'overall_status_arabic' => $this->getOverallStatusArabic($overallStatus),
            'current_stage' => $currentStage,
            'current_stage_arabic' => $currentStage ? $this->getDropArabic($currentStage) : 'لم يبدأ',
            'completed_stages' => $completedStages,
            'total_stages' => $totalStages,
            'progress_percentage' => round(($completedStages / $totalStages) * 100, 2),
            'stage_details' => $stageDetails,
            'next_stage' => $currentStage ? $this->getNextDrop($currentStage) : 'assembly',
            'next_stage_arabic' => $currentStage ? $this->getDropArabic($this->getNextDrop($currentStage)) : 'موافقة الجمعية',
        ];
    }

    /**
     * Get next drop in sequence
     */
    private function getNextDrop(string $currentDrop): ?string
    {
        $drops = ['assembly', 'union', 'committee'];
        $currentIndex = array_search($currentDrop, $drops);

        return ($currentIndex < count($drops) - 1) ? $drops[$currentIndex + 1] : null;
    }

    /**
     * Get drop in Arabic
     */
    private function getDropArabic(string $drop): string
    {
        $drops = [
            'assembly' => 'موافقة الجمعية',
            'union' => 'موافقة الاتحاد',
            'committee' => 'موافقة اللجنة',
        ];

        return $drops[$drop] ?? $drop;
    }

    /**
     * Get status in Arabic
     */
    private function getStatusArabic(string $status): string
    {
        $statuses = [
            'approved' => 'موافق',
            'rejected' => 'مرفوض',
            'pending' => 'قيد الانتظار',
            'need_action' => 'بحاجة إلى إجراء',
        ];

        return $statuses[$status] ?? $status;
    }

    /**
     * Get overall status in Arabic
     */
    private function getOverallStatusArabic(string $status): string
    {
        $statuses = [
            'completed' => 'مكتمل',
            'rejected' => 'مرفوض',
            'need_action' => 'بحاجة إلى إجراء',
            'pending' => 'قيد الانتظار',
            'in_progress' => 'قيد التنفيذ',
        ];

        return $statuses[$status] ?? $status;
    }

    /**
     * Get pending approvals for current user's authority
     */
    public function getPendingApprovals(): JsonResponse
    {
        $user = auth()->user();

        if (! $user->authority_id) {
            return response()->json([
                'success' => false,
                'message' => 'المستخدم غير مرتبط بجهة.',
            ], 403);
        }

        try {
            $authority = Authority::find($user->authority_id);
            $pendingApprovals = $this->approvalService->getPendingApprovalsForAuthority($authority);

            return response()->json([
                'success' => true,
                'pending_approvals' => $pendingApprovals,
                'authority' => $authority->agency_name,
                'count' => $pendingApprovals->count(),
            ]);

        } catch (\Exception $e) {
            Log::error('Get pending approvals error', [
                'user_id' => $user->id,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء جلب الموافقات المعلقة.',
            ], 500);
        }
    }

    /**
     * Reset approval stage to pending (admin only)
     */
    public function resetApprovalStage($projectId, $approvalId): JsonResponse
    {
        if (! auth()->user() || ! auth()->user()->hasRole('admin')) {
            return response()->json([
                'success' => false,
                'message' => 'ليس لديك صلاحية لتنفيذ هذا الإجراء.',
            ], 403);
        }

        try {
            $project = Project::findOrFail($projectId);
            $approval = ProjectApproval::findOrFail($approvalId);

            if ($approval->project_id !== $project->id) {
                return response()->json([
                    'success' => false,
                    'message' => 'الموافقة غير مرتبطة بهذا المشروع.',
                ], 404);
            }

            $this->approvalService->resetApproval($approval);

            return response()->json([
                'success' => true,
                'message' => 'تم إعادة تعيين مرحلة الموافقة إلى قيد الانتظار.',
                'approval' => $approval->fresh(['authority', 'createdBy']),
            ]);

        } catch (\Exception $e) {
            Log::error('Reset approval stage error', [
                'project_id' => $projectId,
                'approval_id' => $approvalId,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء إعادة تعيين المرحلة.',
            ], 500);
        }
    }

    /**
     * Get approval timeline for a project
     */
    public function getApprovalTimeline(Project $project): JsonResponse
    {
        try {

            $timeline = $this->approvalService->getProjectApprovalTimeline($project);

            return response()->json([
