                'project_name' => $project->name,
                'total_entries' => count($timeline),
            ]);

        } catch (\Exception $e) {
            Log::error('Get approval timeline error', [
                'project_id' => $project->id,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء جلب الجدول الزمني للموافقات.',
            ], 500);
        }
    }

    /**
     * Get project approval statistics
     */
    public function getApprovalStatistics($projectId): JsonResponse
    {
        try {
            $project = Project::findOrFail($projectId);

            $stats = [
                'total_approvals' => ProjectApproval::where('project_id', $project->id)->count(),
                'approved_count' => ProjectApproval::where('project_id', $project->id)->where('status', 'approved')->count(),
                'rejected_count' => ProjectApproval::where('project_id', $project->id)->where('status', 'rejected')->count(),
                'pending_count' => ProjectApproval::where('project_id', $project->id)->where('status', 'pending')->count(),
                'need_action_count' => ProjectApproval::where('project_id', $project->id)->where('status', 'need_action')->count(),
                'attachments_count' => ProjectApproval::where('project_id', $project->id)->whereNotNull('attachment')->count(),
                'last_approval_date' => ProjectApproval::where('project_id', $project->id)
                    ->whereNotNull('reviewed_at')
                    ->max('reviewed_at'),
            ];

            return response()->json([
                'success' => true,
                'statistics' => $stats,
                'project' => [
                    'id' => $project->id,
                    'name' => $project->name,
                    'status' => $project->status,
                ],
            ]);

        } catch (\Exception $e) {
            Log::error('Get approval statistics error', [
                'project_id' => $projectId,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء جلب إحصائيات الموافقات.',
            ], 500);
        }
    }

    /**
     * Get project movement log
     */
    public function getProjectMovementLog(Project $project): JsonResponse
    {
        try {

            // Fetch approvals with relationships
            $approvals = ProjectApproval::where('project_id', $project->id)
                ->with(['authority', 'createdBy'])
                ->orderBy('created_at', 'asc')
                ->get();

            // Build movement log and approval history
            $log = [];
            $approvalHistory = [];

            foreach ($approvals as $approval) {
                $movement = [
                    'id' => $approval->id,
                    'timestamp' => $approval->created_at->format('Y-m-d H:i:s'),
                    'stage' => $this->getDropArabic($approval->drop),
                    'authority' => $approval->authority->agency_name ?? 'غير معروف',
                    'reviewer' => $approval->createdBy->name ?? 'غير معروف',
                    'status' => $approval->status,
                    'status_arabic' => $this->getStatusArabic($approval->status),
                    'notes' => $approval->notes,
                    'attachment' => $approval->attachment ? [
                        'name' => basename($approval->attachment),
                        'url' => Storage::url($approval->attachment),
                        'size' => Storage::exists($approval->attachment) ?
                            round(Storage::size($approval->attachment) / 1024 / 1024, 2).' MB' : 'غير متوفر',
                    ] : null,
                    'step_order' => $approval->step_order,
                    'reviewed_at' => $approval->reviewed_at?->format('Y-m-d H:i:s'),
                ];

                $log[] = $movement;

                // Add to approval history if approved
                if ($approval->status === 'approved') {
                    $approvalHistory[] = $movement;
                }
            }

            // Get current project status
            $projectStatus = $this->getCurrentProjectStatus($project);

            return response()->json([
                'success' => true,
                'project_id' => $project->id,
                'project_name' => $project->name,
                'movement_log' => $log,
                'approval_history' => $approvalHistory,
                'project_status' => $projectStatus,
                'total_movements' => count($log),
            ]);

        } catch (\Exception $e) {
            Log::error('Get project movement log error', [
                'project_id' => $project->id,
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء جلب سجل حركة المشروع: '.$e->getMessage(),
            ], 500);
        }
    }

    /**
     * Get pending approvals for current project
     */
    public function getProjectPendingApprovals(Project $project): JsonResponse
    {
        try {
            $pending = ProjectApproval::where('project_id', $project->id)
                ->where('status', 'pending')
                ->with('authority')
                ->get()
                ->map(function ($approval) {
                    return [
                        'stage' => $this->getDropArabic($approval->drop),
                        'authority' => $approval->authority->agency_name ?? 'N/A',
                        'created_at' => $approval->created_at,
                    ];
                });

            return response()->json([
                'success' => true,
                'pending_approvals' => $pending,
                'total_pending' => $pending->count(),
            ]);
        } catch (\Exception $e) {
            Log::error('Get pending approvals error', [
                'project_id' => $project->id,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء جلب الموافقات المعلقة.',
            ], 500);
        }
    }

    /**
     * Get transactions requiring action for current project
     */
    public function getProjectTransactionsRequiringAction(Project $project): JsonResponse
    {
        try {
            $requiring = ProjectApproval::where('project_id', $project->id)
                ->whereIn('status', ['need_action', 'rejected'])
                ->with(['authority', 'createdBy'])
                ->get()
                ->map(function ($approval) {
                    return [
                        'stage' => $this->getDropArabic($approval->drop),
                        'authority' => $approval->authority->agency_name ?? 'N/A',
                        'reviewer_name' => $approval->createdBy->name ?? 'N/A',
                        'status' => $approval->status,
                        'status_arabic' => $this->getStatusArabic($approval->status),
                        'status_color' => $approval->status === 'rejected' ? '#dc3545' : '#fd7e14',
                        'status_icon' => $approval->status === 'rejected' ? 'fas fa-times-circle' : 'fas fa-exclamation-circle',
                        'notes' => $approval->notes,
                        'created_at' => $approval->created_at,
                        'attachment' => $approval->attachment ? ['url' => Storage::url($approval->attachment), 'name' => 'Attachment'] : null,
                    ];
                });

            return response()->json([
                'success' => true,
                'transactions' => $requiring,
                'total_transactions' => $requiring->count(),
            ]);
        } catch (\Exception $e) {
            Log::error('Get transactions requiring action error', [
                'project_id' => $project->id,
                'error' => $e->getMessage(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ أثناء جلب المعاملات المطلوبة.',
            ], 500);
        }
    }

    /**
     * Apply financial adjustments to costs
     */
    private function applyFinancialAdjustments($adjustmentsJson, Project $project): void
    {
        try {
            $adjustments = json_decode($adjustmentsJson, true);

            if (! is_array($adjustments)) {
                return;
            }

            foreach ($adjustments as $adjustment) {
                if ($adjustment['type'] === 'preliminary') {
                    \App\Models\PreliminaryCost::where('id', $adjustment['cost_id'])
                        ->where('project_id', $project->id)
                        ->update([
                            'quantity' => $adjustment['quantity'],
                            'amount' => $adjustment['amount'],
                            'total' => $adjustment['total'],
                        ]);
                } elseif ($adjustment['type'] === 'executive') {
                    \App\Models\ExecutiveActionCost::where('id', $adjustment['cost_id'])
                        ->where('project_id', $project->id)
                        ->update([
                            'quantity' => $adjustment['quantity'],
                            'amount' => $adjustment['amount'],
                            'total' => $adjustment['total'],
                        ]);
                }
            }

            Log::info('Financial adjustments applied', [
                'project_id' => $project->id,
                'adjustments_count' => count($adjustments),
            ]);
        } catch (\Exception $e) {
            Log::error('Failed to apply financial adjustments', [
                'project_id' => $project->id,
                'error' => $e->getMessage(),
            ]);
        }
    }
}
